{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "inherits": "default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mingw",
      "inherits": "default",
      "generator": "Ninja"
    },
    {
      "name": "mingw-make",
      "inherits": "default",
      "generator": "MinGW Makefiles"
    },
    {
      "name": "msvc",
      "binaryDir": "${sourceDir}/build",
      "generator": "Visual Studio 17 2022"
    }
  ]
}
